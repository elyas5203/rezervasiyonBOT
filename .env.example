# ==============================================================================
# نمونه متغیرهای محیطی سامانه رزرواسیون اسکان زائر (الگوی توسعه و شبیه‌سازی محلی)
# هشدار: هیچ توکن، رمز واقعی یا اطلاعات سرور را در این فایل قرار ندهید.
# ==============================================================================

# محیط اجرا: development | production | test
NODE_ENV=production

# پورت سرویس اصلی وب‌سرویس و وب‌هوک‌ها (پیش‌فرض: ۳۰۰۰ جهت عدم تداخل با سایر پورت‌ها)
PORT=3000

# پورت وب‌ویو پنل مدیریت (اختیاری؛ پیش‌فرض مطابق با پورت اصلی یا پورت مجزا)
ADMIN_PORT=3001

# کلید رمزنگاری جلسات و توکن‌های وب‌ویو مدیریت
ADMIN_WEBVIEW_SECRET=change_this_to_a_secure_random_secret_in_production

# آدرس پایه وب‌ویو پنل مدیر جهت ارسال در پیام‌رسان‌ها
ADMIN_WEBVIEW_BASE_URL=http://localhost:3000/admin

# کلیدهای نمونه برای درگاه‌های پیام‌رسان (منحصراً داده ساختگی / Mock)
TELEGRAM_BOT_TOKEN=mock_telegram_bot_token_replace_in_env
BALE_BOT_TOKEN=mock_bale_bot_token_replace_in_env

# مسیر ذخیره‌سازی داده‌ها و تصاویر رسید/گذرنامه
STORAGE_PATH=/app/data
DB_PATH=/app/data/rezervasiyon.db
